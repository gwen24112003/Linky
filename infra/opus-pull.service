[Unit]
Description=Mise a jour d'opusadvisor.fr depuis la branche deploy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/local/bin/opus-pull
# Service des leads du diagnostic facture électronique (infra/lead-api) ; son échec ne bloque pas le site.
ExecStart=-/usr/local/bin/opus-lead-api-pull
