[Unit]
Description=Rappels du diagnostic facture electronique (mails avant echeance)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=opuslead
Group=opuslead
WorkingDirectory=/opt/opus-lead-api/services/lead-api
EnvironmentFile=/etc/opus-lead-api.env
Environment=DB_PATH=/var/lib/opus-lead-api/leads.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning reminders.ts

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/opus-lead-api
StateDirectory=opus-lead-api
StateDirectoryMode=0750
