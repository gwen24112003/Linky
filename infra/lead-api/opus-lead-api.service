[Unit]
Description=Leads du diagnostic facture electronique (opusadvisor.fr/api/diagnostic-lead)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opuslead
Group=opuslead
WorkingDirectory=/opt/opus-lead-api/services/lead-api
EnvironmentFile=/etc/opus-lead-api.env
Environment=DB_PATH=/var/lib/opus-lead-api/leads.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/services/lead-api/server.js
Restart=on-failure
RestartSec=5

# Le service ne peut écrire que dans sa base.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/opus-lead-api
StateDirectory=opus-lead-api
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
