# Modèle de /etc/opus-lead-api.env (propriétaire root, groupe opuslead, droits 640). Jamais versionné rempli.
# Après modification : sudo systemctl restart opus-lead-api

# Envoi par le relais Google Workspace, sans mot de passe : la console d'administration autorise les adresses IP
# du serveur (Applications > Google Workspace > Gmail > Routage > Service de relais SMTP).
# SMTP_USER sert d'adresse d'expédition.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=enzo@opusadvisor.fr
# Autre possibilité : smtp.gmail.com, port 465, avec SMTP_PASS = mot de passe d'application Google
# (saisi avec : sudo lead-api-smtp). Laisser vide pour le relais.
SMTP_PASS=

# Facultatif : expéditeur affiché (par défaut « Opus Advisor » <SMTP_USER>).
# MAIL_FROM="Opus Advisor" <enzo@opusadvisor.fr>

# Reçoit une notification à chaque nouveau lead.
LEAD_NOTIFY_EMAIL=enzo@opusadvisor.fr

# Protège l'export CSV ; 24 caractères minimum. Générer avec : openssl rand -hex 24
ADMIN_TOKEN=

# Facultatif (valeurs par défaut) :
# PORT=3101
# SITE_URL=https://opusadvisor.fr
