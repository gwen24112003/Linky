#!/usr/bin/env bash
# Définit le mot de passe du compte « admin » d'Umami sans jamais l'afficher.
# Usage (depuis le PC) : ssh -t opus-vps sudo umami-password
# Avec --lock : remplace le mot de passe par une valeur aléatoire que personne ne connaît (compte verrouillé).
set -euo pipefail
cd /srv/umami

if [ "${1:-}" = "--lock" ]; then
  pw=$(head -c 48 /dev/urandom | base64)
else
  read -rsp "Nouveau mot de passe Umami (12 caractères minimum) : " pw; echo
  read -rsp "Confirmez : " pw2; echo
  [ "$pw" = "$pw2" ] || { echo "Les deux saisies sont différentes, rien n'a été changé."; exit 1; }
  [ "${#pw}" -ge 12 ] || { echo "Trop court (12 caractères minimum), rien n'a été changé."; exit 1; }
fi

# bcrypt côté serveur ; préfixe $2a$ pour la bibliothèque bcryptjs utilisée par Umami.
hash=$(printf '%s' "$pw" | python3 -c 'import sys, bcrypt; print(bcrypt.hashpw(sys.stdin.buffer.read(), bcrypt.gensalt(10)).decode().replace("$2b$", "$2a$", 1))')
unset pw pw2

updated=$(docker compose exec -T db psql -U umami -d umami -qtAc "update \"user\" set password = '$hash' where username = 'admin' returning username;")
[ "$updated" = "admin" ] || { echo "Compte admin introuvable, rien n'a été changé."; exit 1; }

if [ "${1:-}" = "--lock" ]; then
  echo "Compte admin verrouillé."
else
  echo "Mot de passe enregistré. Connexion sur https://stats.opusadvisor.fr avec l'identifiant admin."
fi
